# ==============================================================================
# CORE (Company Operations, Resources & Environment) Environment Configuration
# ==============================================================================

# Database Configuration
# - Local Development: uses embedded PGlite (WASM PostgreSQL), zero Docker/Postgres setup required.
# - Production: configure DATABASE_URL pointing to external PostgreSQL (e.g. Neon, Supabase, RDS).
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/core_db"

# PGlite Embedded Database Directory (used for local development)
PGLITE_DATA_DIR="./data/core_db"

# Application Environment & URLs
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Mock Authentication (set true for local dev/testing)
AUTH_MOCK_ENABLED=true

# Secrets
NEXTAUTH_SECRET="core-dev-super-secret-key-min-32-chars-long"
CREDENTIAL_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Spreadsheet Ingestion Directory
SPREADSHEET_DIR="/home/noah/Documents/sheets"

# Google Workspace & Sheets Integration (configured like onboarding-copilot)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_SHEETS_ID="15kx94mT2qekbcBV5BEHZhb7M25O3smM2JYQZT_ydgz8"
NEXT_PUBLIC_GOOGLE_SHEETS_ID="15kx94mT2qekbcBV5BEHZhb7M25O3smM2JYQZT_ydgz8"
GOOGLE_SHEETS_ACCOUNTS_ID="15kx94mT2qekbcBV5BEHZhb7M25O3smM2JYQZT_ydgz8"
GOOGLE_SHEETS_DEVICES_ID="1ELcKpCCEYXpI2wg3IIKJ0s3XpfdN92tyiyUOe40S_YQ"
GOOGLE_SHEETS_SOFTWARE_ID="1q_pkNgrfDm7F_fQRF2beOxRvQf9XVE3e4MGPVxSmA5M"
# Optional redirect URI override (defaults to dynamic host/Vercel URL or http://localhost:3000/api/auth/callback/google)
